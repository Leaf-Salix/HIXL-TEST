+++ b/include/hixl/experimental_domain_window.h
@@ -0,0 +1,17 @@
+// 实验接口：不属于官方 HIXL SDK。
+// 调用者持有并保持 addr 对应完整 VMM 分配及其原始映射，禁止子区间/别名登记。
+// Acquire 必须先于 HIXL RegisterMem 和其他 Fabric export；重复 Acquire 返回缓存句柄。
+// 释放顺序：停止通信和 kernel，HIXL Disconnect/Deregister/Finalize，销毁所有导入映射，
+// 然后 Release，最后由原所有者 unmap/free。Release 拒绝仍有 HIXL 注册的窗口。
+#ifndef HIXL_EXPERIMENTAL_DOMAIN_WINDOW_H_
+#define HIXL_EXPERIMENTAL_DOMAIN_WINDOW_H_
+
+#include <cstddef>
+#include <cstdint>
+#include "acl/acl.h"
+
+extern "C" __attribute__((visibility("default"))) uint32_t HixlDomainWindowAcquire(
+    void *addr, size_t len, aclrtMemFabricHandle *out);
+extern "C" __attribute__((visibility("default"))) uint32_t HixlDomainWindowRelease(void *addr);
+
+#endif
