+// Explicit window lifetime: the cache owns a retained PA reference until Release.
+// VA mappings and all imported mappings remain the caller's responsibility.
+struct DomainWindow {
+  size_t len;
+  aclrtDrvMemHandle pa_handle;
+  aclrtMemFabricHandle fabric;
+  size_t registrations = 0;
+};
+std::mutex g_domain_mutex;
+std::unordered_map<uintptr_t, DomainWindow> g_domain_windows;
+
+Status RetainDomainRegistration(uintptr_t addr, size_t len, aclrtDrvMemHandle &pa,
+                                aclrtMemFabricHandle &fabric, bool &found) {
+  std::lock_guard<std::mutex> lock(g_domain_mutex);
+  auto it = g_domain_windows.find(addr);
+  found = it != g_domain_windows.end();
+  if (!found) {
+    return SUCCESS;
+  }
+  ADXL_CHK_BOOL_RET_STATUS(it->second.len == len, PARAM_INVALID, "Domain window length mismatch.");
+  ++it->second.registrations;
+  pa = it->second.pa_handle;
+  fabric = it->second.fabric;
+  return SUCCESS;
+}
+
+void DropDomainRegistration(uintptr_t addr) {
+  std::lock_guard<std::mutex> lock(g_domain_mutex);
+  auto it = g_domain_windows.find(addr);
+  if (it != g_domain_windows.end() && it->second.registrations > 0) {
+    --it->second.registrations;
+  }
+}
 }  // namespace
+
+extern "C" uint32_t HixlDomainWindowAcquire(void *addr, size_t len, aclrtMemFabricHandle *out) {
+  ADXL_CHK_BOOL_RET_STATUS(addr != nullptr && len > 0 && out != nullptr, PARAM_INVALID,
+                           "Invalid domain window arguments.");
+  const uintptr_t base = llm::PtrToValue(addr);
+  std::lock_guard<std::mutex> lock(g_domain_mutex);
+  auto it = g_domain_windows.find(base);
+  if (it != g_domain_windows.end()) {
+    ADXL_CHK_BOOL_RET_STATUS(it->second.len == len, PARAM_INVALID, "Domain window length mismatch.");
+    *out = it->second.fabric;
+    return SUCCESS;
+  }
+  ADXL_CHK_BOOL_RET_STATUS(base <= UINTPTR_MAX - len, PARAM_INVALID, "Domain window address overflow.");
+  for (const auto &entry : g_domain_windows) {
+    ADXL_CHK_BOOL_RET_STATUS(base + len <= entry.first || entry.first + entry.second.len <= base,
+                             PARAM_INVALID, "Overlapping domain windows are unsupported.");
+  }
+  aclrtDrvMemHandle pa = nullptr;
+  ADXL_CHK_ACL_RET(aclrtMemRetainAllocationHandle(addr, &pa));
+  LLM_DISMISSABLE_GUARD(fail_guard, ([&pa] { LLM_CHK_ACL(aclrtFreePhysical(pa)); }));
+  aclrtMemFabricHandle fabric{};
+  ADXL_CHK_ACL_RET(aclrtMemExportToShareableHandleV2(pa, ACL_RT_VMM_EXPORT_FLAG_DISABLE_PID_VALIDATION,
+                                                   ACL_MEM_SHARE_HANDLE_TYPE_FABRIC, &fabric));
+  g_domain_windows.emplace(base, DomainWindow{len, pa, fabric, 0});
+  *out = fabric;
+  LLM_DISMISS_GUARD(fail_guard);
+  return SUCCESS;
+}
 
+extern "C" uint32_t HixlDomainWindowRelease(void *addr) {
+  ADXL_CHK_BOOL_RET_STATUS(addr != nullptr, PARAM_INVALID, "Null domain window.");
+  std::lock_guard<std::mutex> lock(g_domain_mutex);
+  auto it = g_domain_windows.find(llm::PtrToValue(addr));
+  ADXL_CHK_BOOL_RET_STATUS(it != g_domain_windows.end(), PARAM_INVALID, "Unknown domain window.");
+  ADXL_CHK_BOOL_RET_STATUS(it->second.registrations == 0, RESOURCE_EXHAUSTED,
+                           "Domain window still has active HIXL registrations.");
+  ADXL_CHK_ACL_RET(aclrtFreePhysical(it->second.pa_handle));
+  g_domain_windows.erase(it);
+  return SUCCESS;
+}
